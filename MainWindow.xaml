
<Window x:Class="OpenNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenNotch"
        Width="340"
        Height="56"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual">
       

    <Window.Resources>
        
        <SolidColorBrush x:Key="PanelBg" Color="#08090D"/>
        <SolidColorBrush x:Key="CardBg" Color="#171821"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#35D07F"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#252630"/>
        <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#999BAA"/>

        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="Island"
            Width="340"
            Height="56"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{DynamicResource PanelBg}"
            BorderThickness="1.5"
            CornerRadius="28"
            ClipToBounds="False"
            MouseLeftButtonDown="Island_MouseLeftButtonDown">

        <Grid x:Name="GlowHost"
              ClipToBounds="False">

            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- COLLAPSED NOTCH -->

            <Grid Grid.Row="0" Margin="12,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Ellipse x:Name="Dot"
                             Width="8"
                             Height="8"
                             Fill="{DynamicResource AccentBrush}"
                             Margin="0,0,8,0"/>

                    <Border x:Name="ArtBorder"
                            Width="22"
                            Height="22"
                            CornerRadius="5"
                            Background="#252630"
                            Visibility="Collapsed"
                            Margin="0,0,7,0"/>

                    <TextBlock x:Name="LeftText"
                               Text="OPENNOTCH"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="145"/>

                    <Border x:Name="LiveBarTrack"
                            Width="42"
                            Height="4"
                            Background="#41424E"
                            CornerRadius="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ClipToBounds="True">

                        <Border x:Name="LiveBarFill"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                RenderTransformOrigin="0,0.5">

                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LiveScale"
                                                ScaleX="0"
                                                ScaleY="1"/>
                            </Border.RenderTransform>

                        </Border>
                    </Border>

                </StackPanel>

                <TextBlock x:Name="StatsText"
                           Grid.Column="1"
                           Text="CPU 0% RAM 0%"
                           Foreground="#999BAA"
                           FontSize="9"
                           VerticalAlignment="Center"
                           Margin="5,0,8,0"/>

                <Button x:Name="ExpandButton"
                        Grid.Column="2"
                        Content="+"
                        Width="26"
                        Height="25"
                        Padding="0"
                        Style="{StaticResource IslandButton}"
                        Click="ExpandButton_Click"/>

            </Grid>

            <!-- EXPANDED DASHBOARD -->

            <Grid x:Name="ExpandedPanel"
                  Grid.Row="1"
                  Margin="14,5,14,12"
                  Visibility="Collapsed"
                  Opacity="0"
                  IsHitTestVisible="False">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- MUSIC PLAYER -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BigArtBorder"
                            Width="60"
                            Height="60"
                            CornerRadius="10"
                            Background="#1B1C25"
                            ClipToBounds="True">

                        <TextBlock x:Name="BigArtNote"
                                   Text="♫"
                                   Foreground="#888999"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="PlaybackTitle"
                                   Text="Nothing playing"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="PlaybackArtist"
                                   Text=""
                                   Foreground="#999BAA"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,8,0,0">

                            <Button Content="|◀"
                                    Width="42"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource IslandButton}"
                                    Click="Previous_Click"/>

                            <Button x:Name="PlayButton"
                                    Content="▶"
                                    Width="42"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource IslandButton}"
                                    Click="PlayPause_Click"/>

                            <Button Content="▶|"
                                    Width="42"
                                    Style="{StaticResource IslandButton}"
                                    Click="Next_Click"/>

                        </StackPanel>

                    </StackPanel>
                </Grid>

                <!-- SYSTEM MONITOR -->

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBg}"
                        CornerRadius="12"
                        Padding="10"
                        Margin="0,0,0,10">

                    <StackPanel>

                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="CPU"
                                       Foreground="#B9BAC6"
                                       FontSize="10"/>

                            <TextBlock x:Name="CpuText"
                                       Text="0%"
                                       Foreground="White"
                                       FontSize="10"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="5"
                                Background="#30313C"
                                CornerRadius="3"
                                ClipToBounds="True">

                            <Border x:Name="CpuBarFill"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    RenderTransformOrigin="0,0.5">

                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CpuScale"
                                                    ScaleX="0"
                                                    ScaleY="1"/>
                                </Border.RenderTransform>

                            </Border>
                        </Border>

                        <Grid Margin="0,9,0,5">
                            <TextBlock Text="RAM"
                                       Foreground="#B9BAC6"
                                       FontSize="10"/>

                            <TextBlock x:Name="RamText"
                                       Text="0.0 / 0.0 GB"
                                       Foreground="White"
                                       FontSize="10"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="5"
                                Background="#30313C"
                                CornerRadius="3"
                                ClipToBounds="True">

                            <Border x:Name="RamBarFill"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    RenderTransformOrigin="0,0.5">

                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="RamScale"
                                                    ScaleX="0"
                                                    ScaleY="1"/>
                                </Border.RenderTransform>

                            </Border>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- FOCUS TIMER -->

                <Border Grid.Row="2"
                        Background="{DynamicResource CardBg}"
                        CornerRadius="12"
                        Padding="9"
                        Margin="0,0,0,10">

                    <StackPanel>

                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="FOCUS TIMER"
                                       Foreground="#999BAA"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="ThemeButton"
                                    Content="Choose colour"
                                    ToolTip="Choose a custom OpenNotch theme colour"
                                    Width="96"
                                    Height="22"
                                    Padding="6,2"
                                    FontSize="9"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource IslandButton}"
                                    Click="ChooseTheme_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal">

                            <Button Content="15 min"
                                    Tag="15"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource IslandButton}"
                                    Click="StartTimer_Click"/>

                            <Button Content="25 min"
                                    Tag="25"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource IslandButton}"
                                    Click="StartTimer_Click"/>

                            <Button Content="45 min"
                                    Tag="45"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource IslandButton}"
                                    Click="StartTimer_Click"/>

                            <Button Content="Stop"
                                    Style="{StaticResource IslandButton}"
                                    Click="StopTimer_Click"/>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ANIMATED CAT -->

                <Grid Grid.Row="3"
                      Width="55"
                      Height="42"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Grid x:Name="HeadBob"
                          Width="40"
                          Height="35">

                        <Ellipse Width="28"
                                 Height="25"
                                 Fill="#E9E9EF"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"/>

                        <Polygon Points="5,13 8,0 16,10"
                                 Fill="#E9E9EF"
                                 HorizontalAlignment="Left"/>

                        <Polygon Points="29,10 37,0 39,13"
                                 Fill="#E9E9EF"
                                 HorizontalAlignment="Right"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,7,0,0">

                            <Ellipse Width="3"
                                     Height="6"
                                     Fill="#171821"
                                     Margin="0,0,8,0">

                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="EyeScale"
                                                    ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Ellipse Width="3"
                                     Height="6"
                                     Fill="#171821"/>
                        </StackPanel>
                    </Grid>

                    <Path Data="M 10,27 C -5,30 -3,12 7,15"
                          Stroke="#E9E9EF"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"
                          RenderTransformOrigin="0.8,0.5">

                        <Path.RenderTransform>
                            <RotateTransform x:Name="TailRot"
                                             Angle="0"/>
                        </Path.RenderTransform>
                    

                    </Path>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>